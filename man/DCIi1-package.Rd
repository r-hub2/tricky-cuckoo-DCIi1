\name{DCIi1-package}
\alias{DCIi1-package}
\alias{DCIi1}
\docType{package}
\title{I1 Mean-Change Testing and DCI Candidate Detection}
\description{Adaptive mean contrasts, the I1 statistic, localized scaling,
descriptive DCI candidate detection and segmentation covering metrics.}
\details{Start with \code{\link{i1_test}} for the 100-observation independent
Gaussian reference test, or \code{\link{i1_stt}} for statistic-only analysis.
Use \code{\link{dcii1}} for descriptive candidate locations. DCI does not
perform significance testing. See the package vignettes for examples.}
\references{Waychal, N., Laha, A. K. and Sinha, A. (2026).
Closely spaced change-point detection with an application to geopolitical
shocks in oil and gas markets. \doi{10.48550/arXiv.2610.23476}.}
